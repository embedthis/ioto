{
    version: '1.0.0',
    profile: 'dev',
    app: 'blank',
    conditional: {
        profile: {
            dev: {
                directories: {
                    certs: '../../certs',
                    log: '.',
                    state: 'state',
                },
                log: {
                    path: 'stdout',
                    format: '%S: %M',
                    types: 'error,info',
                    sources: 'all,!mbedtls',
                    show: '',
                },
            },
            prod: {
                directories: {
                    log: '/var/log',
                    state: '/var/lib/ioto',
                },
            },
        },
    },
    database: {
        path: '@db/device.db',
        schema: '@config/schema.json5',
        maxJournalSize: '50k',
        maxJournalAge: '15secs',
        maxSyncSize: '10k',
        service: '1hr',
    },
    limits: {
        reprovision: 5,
        _fiberStack: '64k',
        /*
            fibers - the ceiling on concurrently serviced connections, and the one that actually
            binds. The web server holds one fiber per connection for the whole request, so this is
            the real limit, not web.limits.connections. Left unset it is derived from
            web.limits.connections with headroom for the agent's background work, which is what you
            want. Set it only to cap a constrained device, and expect fewer connections than
            web.limits.connections advertises if you set it lower.
         */
        _fibers: 108,
    },
    log: {
        path: 'stdout',
        format: '%D %H %A[%P] (%T, %S): %M',
        types: 'error,info',
        sources: 'all,!mbedtls',
        show: '',
    },
    mqtt: {
        authority: '@certs/aws.crt',
        schedule: '* * * * *',
        delay: 15,
        timeout: 0,
    },
    services: {
        ai: true,
        database: true,
        keys: false,
        logs: false,
        mqtt: true,
        provision: true,
        register: true,
        serialize: 'auto',
        shadow: false,
        sync: true,
        update: true,
        url: true,
        web: true,
    },
    scripts: {
        update: 'bin/updater',
    },
    tls: {
        authority: '@certs/roots.crt',
        certificate: '@certs/test.crt',
        key: '@certs/test.key',
    },
    update: {
        enable: true,
        schedule: '* * * * *',
        period: '24 hr',
        jitter: 0,
        throttle: 0,
        apply: '* * * * *',
    }
}