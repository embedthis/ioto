/*
    web.json5 - Web server configuration file

    For a full list of properties: https://www.embedthis.com/agent/doc/web/properties/

    SECURE DEFAULTS - READ BEFORE DEPLOYING
    ---------------------------------------
    This template binds the loopback interface on unprivileged ports, so out of the box the server
    is reachable only from the device itself and does not need root to run. That is deliberate: a
    template that is reachable from the network the moment it is built is a template that ships
    insecure by accident.

    Before the device leaves a trusted network you must:

      1. Change "listen" to the interface you intend to serve, and serve https with a real
         certificate. The certificates under state/certs are self-signed development material and
         must never reach production.
      2. Give every route an explicit "role" unless it is genuinely public. An unrecognised key is
         ignored with a warning - a mistyped "role" leaves the route unauthenticated.
      3. Review the limits and timeouts below against your device's real capacity.
*/
{
    auth: {
        roles: {
            public: [],
            user: [],
            admin: ['user'],
            owner: ['admin'],
            super: ['owner']
        },
        login: '/api/public/login',
        logout: '/api/public/logout',
    },
    documents: 'site',
    headers: {
        'X-Content-Type-Options': 'nosniff',
        'X-Frame-Options': 'SAMEORIGIN',
        'Referrer-Policy': 'no-referrer',
        'Content-Security-Policy': "default-src 'self'",
    },
    index: 'index.html',
    limits: {
        body: '100K',
        connections: '100',
        header: '10K',
        sessions: '100',
        upload: '20MB',
        maxFrame: '100K',
        maxMessage: '100K',
    },
    listen: ['http://127.0.0.1:8080', 'https://127.0.0.1:4443'],
    redirect: [{status: 302, from: 'http://127.0.0.1:8080', to: 'https://127.0.0.1:4443'}],
    routes: [
        {match: '/api/user/', handler: 'action', role: 'user', validate: true},
        {match: '/api/public/', handler: 'action', validate: true},
        {match: '/admin/', handler: 'file', role: 'admin'},
        {match: '/user/', handler: 'file', role: 'user'},
        {match: '', handler: 'file', methods: ['GET', 'OPTIONS']},
    ],
    signatures: {
        enable: false,
    },
    timeouts: {
        inactivity: '300 secs',
        parse: '10 secs',
        request: '10 mins',
        session: '30 mins',
        tls: '1 day',
    },
    upload: {
        dir: 'tmp',
        remove: true,
    },
    webSockets: {
        ping: 'never',
        protocol: 'chat',
        validateUTF: false,
    },
}
