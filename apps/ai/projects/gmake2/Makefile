# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug_macosx
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug_macosx)
  ioto_ai_config = debug_macosx

else ifeq ($(config),debug_linux)
  ioto_ai_config = debug_linux

else ifeq ($(config),debug_freebsd)
  ioto_ai_config = debug_freebsd

else ifeq ($(config),release_macosx)
  ioto_ai_config = release_macosx

else ifeq ($(config),release_linux)
  ioto_ai_config = release_linux

else ifeq ($(config),release_freebsd)
  ioto_ai_config = release_freebsd

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := ioto-ai

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

ioto-ai:
ifneq (,$(ioto_ai_config))
	@${MAKE} --no-print-directory -C . -f ioto-ai.make config=$(ioto_ai_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f ioto-ai.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug_macosx"
	@echo "  debug_linux"
	@echo "  debug_freebsd"
	@echo "  release_macosx"
	@echo "  release_linux"
	@echo "  release_freebsd"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   ioto-ai"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"