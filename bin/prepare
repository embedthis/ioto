#!/usr/bin/env bash
#
#   prepare - Prepare the app state directory
#
#   Called from the project top directory with APP name as argument.
#   Copies config files to the app's state directory.
#

APP=${1:-http}
TOP=${PWD}
JSON=${TOP}/build/bin/json
PATH=${TOP}/bin:${TOP}/build/bin:${PATH}

if [ ! -d src ] ; then
    echo "Must run from the top directory"
    exit 1
fi

if [ ! -d "apps/${APP}" ] ; then
    echo "      [Error] Unknown app \"${APP}\""
    exit 255
fi

#
#   Change to the app directory
#
cd apps/${APP}

mkdir -p state/config state/db

#
#   Copy applicable config files to state/config
#
for file in db.json5 device.json5 display.json5 ioto.json5 local.json5 web.json5; do
    if [ -f ${file} ] ; then
        if [ ! -f state/config/${file} -o ${file} -nt state/config/${file} ] ; then
            echo "      [Copy] ${file} -> state/config/${file}"
            cp ${file} state/config/${file}
        fi
    fi
done

#
#   Blend schema.json5 to state/config/schema.json5
#
if [ -f schema.json5 ] ; then
    if [ ! -f state/config/schema.json5 -o schema.json5 -nt state/config/schema.json5 ] ; then
        echo "     [Blend] schema.json5 -> state/config/schema.json5"
        ${JSON} --blend schema.json5 > state/config/schema.json5
        if [ ! -s state/config/schema.json5 ] ; then
            echo "Error blending schema.json5"
            exit 255
        fi
    fi
fi

#
#   Copy web site if it exists
#
if [ -d site ] ; then
    if [ ! -d state/site ] ; then
        echo "      [Copy] Web site for ${APP}"
        mkdir -p state/site
    fi
    find state/site -type f -print | xargs -r rm
    cp -r site/* state/site
fi

#
#   Process signatures.json5 if it exists
#
if [ -f signatures.json5 ] ; then
    if [ ! -f state/config/signatures.json5 -o signatures.json5 -nt state/config/signatures.json5 ] ; then
        echo "      [Make] make-sig signatures.json5 state/config/signatures.json5"
        make-sig \
            --blend Schema=state/config/schema.json5 \
            --blend SupportQuery=${TOP}/schemas/parts/SupportQuery.json5 \
            --blend Query=${TOP}/schemas/parts/Query.json5 \
            --blend Match=${TOP}/schemas/parts/Match.json5 \
            signatures.json5 state/config/signatures.json5
        touch state/config/signatures.json5
    fi
fi
